// Projet : Lar-allegria
// Site : Lar'Allegria by Lara Rossoux — V01-017
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estConnecte() {
      return request.auth != null;
    }
    function estAdmin() {
      return estConnecte() &&
        get(/databases/$(database)/documents/membres/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }
    function estSuperAdmin() {
      return estConnecte() &&
        get(/databases/$(database)/documents/membres/$(request.auth.uid)).data.role == 'superadmin';
    }
    function monMembre() {
      return get(/databases/$(database)/documents/membres/$(request.auth.uid)).data;
    }
    function estChefBenevoles() {
      return estConnecte() && monMembre().chefBenevoles == true;
    }
    function estBenevoleSimple() {
      return estConnecte() && monMembre().typeMembre == 'benevole' && monMembre().chefBenevoles != true;
    }

    function champsAutorisesMembre() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['gsm','email','adressePostale','niveauEquitation','contactUrgence',
                  'assuranceRC','chevaux','cotisationRenouvellement',
                  'motDePasseActuel','derniereConnexion']);
    }

    match /membres/{uid} {
      allow read: if estConnecte() && (request.auth.uid == uid || estAdmin());
      allow create: if estAdmin();
      allow update: if estAdmin() || (estConnecte() && request.auth.uid == uid && champsAutorisesMembre());
      allow delete: if estAdmin();
    }

    // Demandes d'inscription : formulaire public, écrit par des visiteurs
    // non connectés. Lecture/traitement réservés à l'admin.
    match /demandes_inscription/{id} {
      allow create: if request.resource.data.statut == 'en_attente';
      allow read, update, delete: if estAdmin();
    }

    // Réservations de la piste (cours ou usage libre) — une seule validée
    // par créneau, contrôlé côté application par l'admin au moment de la
    // validation.
    match /reservations/{id} {
      allow read: if estConnecte();
      allow create: if estAdmin() || (
        estConnecte() && request.resource.data.membreId == request.auth.uid
        && request.resource.data.statut == 'en_attente'
      );
      allow update: if estAdmin() || (
        estConnecte() && resource.data.membreId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','motifAnnulation','motifAnnulationDetail']) &&
        request.resource.data.statut == 'annulee'
      );
      allow delete: if estAdmin();
    }

    match /boxes/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /nettoyages/{id} {
      allow read: if estAdmin() || (estConnecte() && resource.data.assigneA == request.auth.uid);
      allow create, delete: if estAdmin();
      allow update: if estAdmin() || (
        estConnecte() && resource.data.assigneA == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','dateRealisation'])
      );
    }

    // Grille tarifaire : lisible publiquement (page tarifs.html du site).
    match /tarifs/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    match /activites/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /activites_reponses/{id} {
      allow read: if estConnecte() && (resource.data.uid == request.auth.uid || estAdmin());
      allow create: if estConnecte() && request.resource.data.uid == request.auth.uid;
      allow update: if estAdmin() || (estConnecte() && resource.data.uid == request.auth.uid);
      allow delete: if estAdmin();
    }

    match /conversations/{uid} {
      allow read, write: if estConnecte() && (request.auth.uid == uid || estAdmin());
      match /messages/{msgId} {
        allow read, create, update: if estConnecte() && (request.auth.uid == uid || estAdmin());
      }
    }

    match /paiements/{id} {
      allow read: if estConnecte() && (resource.data.membreId == request.auth.uid || estAdmin());
      allow create, update, delete: if estAdmin();
    }

    match /parametres/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /articles_boutique/{id} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    match /commandes/{id} {
      allow read: if estConnecte() && (resource.data.membreId == request.auth.uid || estAdmin());
      allow create: if estConnecte() && request.resource.data.membreId == request.auth.uid;
      allow update, delete: if estAdmin();
    }

    // Textes des pages publiques, modifiables depuis l'admin ("Contenu du site").
    match /contenu_site/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Chevaux de l'écurie (propriété de Lara) — page publique "Nos chevaux".
    match /chevaux_ecurie/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Cartes numérotées de la page publique "Activités" — numérotation
    // recalculée à l'affichage à partir du champ ordre + visiblePublic.
    match /programme_activites/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Jours fermés / horaires exceptionnels (par date), en plus des horaires
    // hebdomadaires par défaut dans parametres/disponibilites.
    match /disponibilites_exceptions/{date} {
      allow read: if estConnecte();
      allow write: if estAdmin();
    }

    // Événements (portes ouvertes, journées club...), visibles publiquement.
    match /evenements/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Stock (foin, nourriture...) : l'admin et le super-admin gèrent tout,
    // en plus comme en moins. Le "chef des bénévoles" (statut particulier
    // porté par un membre bénévole) a les mêmes droits +/- sur le stock
    // uniquement, sans accès au reste de l'admin. Un bénévole "simple" ne
    // peut que diminuer une quantité (signaler une prise), jamais l'augmenter.
    // Les membres cours et demi-pension n'ont aucun droit sur le stock.
    match /stock/{id} {
      allow read: if estConnecte();
      allow create, delete: if estAdmin();
      allow update: if estAdmin() || (
        estChefBenevoles() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantite'])
      ) || (
        estBenevoleSimple() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantite']) &&
        request.resource.data.quantite <= resource.data.quantite
      );
    }

    // Journal des prises/ajouts de stock signalés par les bénévoles (simples
    // ou chef) — les membres cours/demi-pension n'y ont pas accès.
    match /stock_signalements/{id} {
      allow read: if estAdmin();
      allow create: if estConnecte() && request.resource.data.membreId == request.auth.uid &&
        (estChefBenevoles() || estBenevoleSimple());
      allow delete: if estAdmin();
    }

    // Articles de blog / newsletter, publics.
    match /articles_blog/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Planning des membres bénévoles (qui vient quand, pour quelle tâche).
    // Lecture ouverte à tout membre connecté pour que l'équipe voie le
    // planning complet ; un bénévole ne peut cocher que ses propres créneaux.
    // Créneaux bénévoles : l'admin peut créer un créneau ouvert (non
    // assigné) que n'importe quel membre bénévole peut ensuite prendre en
    // charge lui-même, en plus de l'assignation directe par l'admin.
    match /planning_benevoles/{id} {
      allow read: if estConnecte();
      allow create, delete: if estAdmin();
      allow update: if estAdmin() || (
        estConnecte() && resource.data.assigneA == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut','dateRealisation'])
      ) || (
        estConnecte() && (!('assigneA' in resource.data) || resource.data.assigneA == null || resource.data.assigneA == '') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneA','assigneNom'])
      );
    }

    // Historique des sauvegardes de mots de passe, créé automatiquement à
    // chaque connexion réussie du super-admin. Réservé au super-admin.
    match /sauvegardes_mdp/{id} {
      allow read, create: if estSuperAdmin();
    }

    // Comptabilité (livre de caisse + plan comptable) — données financières
    // sensibles, strictement réservées à l'admin et au super-admin.
    match /comptabilite_ecritures/{id} {
      allow read, write: if estAdmin();
    }
    match /comptabilite_comptes/{id} {
      allow read, write: if estAdmin();
    }
    match /livre_recettes/{id} {
      allow read, write: if estAdmin();
    }
    match /livre_caisse/{id} {
      allow read, write: if estAdmin();
    }
    match /livre_caisse_parametres/{id} {
      allow read, write: if estAdmin();
    }

    // Livre d'or public : n'importe qui peut proposer un message (statut
    // toujours "en_attente" à la création, pas de champ superflu) ; seul un
    // message au statut "publie" est visible publiquement ; la modération
    // (publier/supprimer) est réservée à l'admin.
    match /livre_or/{id} {
      allow read: if resource.data.statut == 'publie' || estAdmin();
      allow create: if request.resource.data.statut == 'en_attente' &&
        request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 60 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 600 &&
        request.resource.data.keys().hasOnly(['nom','message','statut','date','createdAt']);
      allow update, delete: if estAdmin();
    }
  }
}
